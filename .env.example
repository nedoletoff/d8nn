# AI RPG Engine - environment template
#
# Copy to `.env` and fill in if you want the LLM narrative layer.
# Without a key the engine runs in OFFLINE mode: dice, movement, combat and
# every deterministic mechanic keep working, only the prose is templated.

# --- LLM provider (any OpenAI-compatible endpoint) -------------------------
# Works with OpenAI, DeepSeek, OpenRouter, Groq, Together, a local Ollama or
# LM Studio, etc. Just set the base URL and the model id.
#
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com       LLM_MODEL=deepseek-chat
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=deepseek/deepseek-chat
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.1  (any key)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: separate models for intent parsing / narration (else LLM_MODEL).
INTENT_MODEL=
NARRATOR_MODEL=

# Legacy OpenRouter names still work as a fallback:
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=deepseek/deepseek-chat

# --- LLM client behaviour --------------------------------------------------
LLM_TIMEOUT=30
LLM_RETRIES=3
# auto  = try LLM, fall back to offline on any failure
# force = raise on LLM failure (useful for debugging the narrative layer)
OFFLINE_MODE=auto

# --- Deterministic engine --------------------------------------------------
# Seed for the hidden RNG. The LLM never sees this value.
# Leave empty to generate a fresh seed on new game.
RNG_SEED=

# Dice fudging is OFF by default: canon must stay a pure function.
# When enabled, every fudged roll is logged with roll.fudged=true.
FUDGE_DICE=false

# --- Storage / logging -----------------------------------------------------
SAVE_DIR=saves
DATA_DIR=data
LOG_DIR=logs
# Write the game to its slot after every turn.
AUTOSAVE=true
# Emojis in the UI. Off by default for a perfectly aligned layout.
# Turn on with EMOJI=true or the /emoji on command.
EMOJI=false
# Emit a full sha256 hash-chain before enabling fudging (integrity audit).
CANON_CHAIN_ENABLED=true
